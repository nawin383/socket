# Kite Connect app credentials (from developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=

# Your Zerodha login (used only for the automated daily TOTP login — see README)
KITE_USER_ID=
KITE_PASSWORD=
# Base32 TOTP secret from Kite's "Enable 2FA via authenticator app" QR code setup
# (NOT a 6-digit code — the secret string used to generate them)
KITE_TOTP_SECRET=

# Optional: Telegram alerts (message @BotFather to create a bot + get chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
